{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucky Number",
  "version": "1.0.0",
  "identifier": "com.luckynumber.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "幸运号码 · Lucky Number",
        "width": 1200,
        "height": 880,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#080A14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
